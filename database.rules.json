{
  "rules": {
    "users": {
      ".read": "auth != null && ((root.child('users').child(auth.uid).child('role').val() === 'executive' || root.child('users').child(auth.uid).child('role').val() === 'officer') || root.child('users').child(auth.uid).child('role').val() === 'committee')",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && ((auth.uid === $uid && (!data.exists() || !newData.exists())) || (root.child('users').child(auth.uid).child('role').val() === 'executive' || root.child('users').child(auth.uid).child('role').val() === 'officer'))",
        ".validate": "newData.hasChildren(['fullName', 'studentNumber', 'role', 'requestedRole'])",
        "fullName": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.isString() && newData.val().length >= 3 && newData.val().length <= 100"
        },
        "studentNumber": {
          ".validate": "newData.isString() && newData.val().length >= 5 && newData.val().length <= 30 && (data.exists() || newData.val().toLowerCase() + '@plmar-criminology.app' === auth.token.email)"
        },
        "role": {
          ".validate": "(newData.val() === 'student' || newData.val() === 'committee' || newData.val() === 'officer' || newData.val() === 'executive') && (newData.val() === 'student' || (root.child('users').child(auth.uid).child('role').val() === 'executive' || root.child('users').child(auth.uid).child('role').val() === 'officer'))"
        },
        "requestedRole": {
          ".validate": "(newData.val() === 'student' || newData.val() === 'committee' || newData.val() === 'officer' || newData.val() === 'executive')"
        },
        "createdAt": {
          ".validate": "newData.isNumber()"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "rooms": {
      "$room": {
        ".read": "auth != null && root.child('users').child(auth.uid).child('role').exists()",
        ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'executive' || root.child('users').child(auth.uid).child('role').val() === 'officer')",
        ".validate": "newData.hasChildren(['json', 'writer', 'updatedAt'])"
      }
    },
    "proposals": {
      "$room": {
        ".read": "auth != null && ((root.child('users').child(auth.uid).child('role').val() === 'executive' || root.child('users').child(auth.uid).child('role').val() === 'officer') || root.child('users').child(auth.uid).child('role').val() === 'committee')",
        "$pid": {
          ".write": "auth != null && ((root.child('users').child(auth.uid).child('role').val() === 'executive' || root.child('users').child(auth.uid).child('role').val() === 'officer') || (root.child('users').child(auth.uid).child('role').val() === 'committee' && !data.exists() && newData.child('by').val() === auth.uid && newData.child('status').val() === 'pending'))",
          ".validate": "newData.hasChildren(['json', 'by', 'byName', 'status', 'createdAt'])"
        }
      }
    },
    "notifications": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid && !newData.exists()",
        "$nid": {
          ".write": "auth != null && ((auth.uid === $uid && data.exists()) || (root.child('users').child(auth.uid).child('role').val() === 'executive' || root.child('users').child(auth.uid).child('role').val() === 'officer'))",
          ".validate": "newData.hasChildren(['title', 'body', 'createdAt']) && newData.child('title').isString() && newData.child('title').val().length <= 120 && newData.child('body').isString() && newData.child('body').val().length <= 500"
        }
      }
    },
    "announcements": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('role').exists()",
      "$id": {
        ".write": "auth != null && ((root.child('users').child(auth.uid).child('role').val() === 'executive' || root.child('users').child(auth.uid).child('role').val() === 'officer') || (root.child('users').child(auth.uid).child('role').val() === 'committee' && ((!data.exists() && newData.child('by').val() === auth.uid) || (data.exists() && !newData.exists() && data.child('by').val() === auth.uid))))",
        ".validate": "newData.hasChildren(['title', 'body', 'by', 'byName', 'createdAt']) && newData.child('title').isString() && newData.child('title').val().length <= 120 && newData.child('body').isString() && newData.child('body').val().length <= 2000"
      }
    },
    "policies": {
      "meta": {
        ".read": "auth != null && root.child('users').child(auth.uid).child('role').exists()",
        "$id": {
          ".write": "auth != null && ((root.child('users').child(auth.uid).child('role').val() === 'executive' || root.child('users').child(auth.uid).child('role').val() === 'officer') || (root.child('users').child(auth.uid).child('role').val() === 'committee' && ((!data.exists() && newData.child('by').val() === auth.uid) || (data.exists() && !newData.exists() && data.child('by').val() === auth.uid))))",
          ".validate": "newData.hasChildren(['title', 'fileName', 'size', 'by', 'byName', 'createdAt']) && newData.child('size').isNumber() && newData.child('size').val() <= 3145728 && (!newData.child('category').exists() || newData.child('category').val() === 'normal' || newData.child('category').val() === 'policy')"
        }
      },
      "files": {
        "$id": {
          ".read": "auth != null && root.child('users').child(auth.uid).child('role').exists()",
          ".write": "auth != null && ((root.child('users').child(auth.uid).child('role').val() === 'executive' || root.child('users').child(auth.uid).child('role').val() === 'officer') || (root.child('users').child(auth.uid).child('role').val() === 'committee' && (!data.exists() || (!newData.exists() && root.child('policies').child('meta').child($id).child('by').val() === auth.uid))))",
          ".validate": "newData.hasChildren(['data']) && newData.child('data').isString() && newData.child('data').val().length <= 4300000"
        }
      }
    },
    "violations": {
      "inbox": {
        "$uid": {
          ".read": "auth != null && (auth.uid === $uid || (root.child('users').child(auth.uid).child('role').val() === 'executive' || root.child('users').child(auth.uid).child('role').val() === 'officer'))",
          "$id": {
            ".write": "auth != null && ((((root.child('users').child(auth.uid).child('role').val() === 'executive' || root.child('users').child(auth.uid).child('role').val() === 'officer') || root.child('users').child(auth.uid).child('role').val() === 'committee') && !data.exists() && newData.child('from').val() === auth.uid && newData.child('to').val() === $uid) || (data.exists() && !newData.exists() && ((root.child('users').child(auth.uid).child('role').val() === 'executive' || root.child('users').child(auth.uid).child('role').val() === 'officer') || data.child('from').val() === auth.uid)))",
            "ackAt": {
              ".write": "auth != null && auth.uid === $uid && !data.exists()",
              ".validate": "newData.isNumber()"
            },
            ".validate": "newData.hasChildren(['to', 'toName', 'toSN', 'from', 'fromName', 'title', 'details', 'incidentDate', 'createdAt']) && newData.child('title').isString() && newData.child('title').val().length >= 3 && newData.child('title').val().length <= 120 && newData.child('details').isString() && newData.child('details').val().length >= 3 && newData.child('details').val().length <= 2000 && (!newData.child('action').exists() || (newData.child('action').isString() && newData.child('action').val().length <= 500)) && newData.child('to').val() === $uid"
          }
        }
      },
      "sent": {
        ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'executive' || root.child('users').child(auth.uid).child('role').val() === 'officer')",
        "$sender": {
          ".read": "auth != null && auth.uid === $sender",
          "$id": {
            ".write": "auth != null && ((auth.uid === $sender && ((root.child('users').child(auth.uid).child('role').val() === 'executive' || root.child('users').child(auth.uid).child('role').val() === 'officer') || root.child('users').child(auth.uid).child('role').val() === 'committee') && !data.exists() && newData.child('from').val() === auth.uid) || (data.exists() && !newData.exists() && (auth.uid === $sender || (root.child('users').child(auth.uid).child('role').val() === 'executive' || root.child('users').child(auth.uid).child('role').val() === 'officer'))))",
            "ackAt": {
              ".write": "auth != null && data.parent().child('to').val() === auth.uid && !data.exists()",
              ".validate": "newData.isNumber()"
            },
            ".validate": "newData.hasChildren(['to', 'toName', 'toSN', 'from', 'fromName', 'title', 'details', 'incidentDate', 'createdAt']) && newData.child('title').isString() && newData.child('title').val().length >= 3 && newData.child('title').val().length <= 120 && newData.child('details').isString() && newData.child('details').val().length >= 3 && newData.child('details').val().length <= 2000 && (!newData.child('action').exists() || (newData.child('action').isString() && newData.child('action').val().length <= 500)) && newData.child('from').val() === $sender"
          }
        }
      }
    }
  }
}